# .env.example — 필요한 설정 이름과 예시 값 (Git에 올림)
# 실제 값은 이 파일을 .env로 복사한 뒤 .env에 적는다 (.env는 Git에 올리지 않음)
# 옆의 [n단계]는 그 설정을 처음 쓰는 단계

# Django [3단계]
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL [3단계]
POSTGRES_DB=vision_action
POSTGRES_USER=vision
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis·Celery [6단계]
REDIS_URL=redis://localhost:6379/0

# FastAPI 추론 서버 주소 [7단계] (Docker Compose에서는 http://fastapi:8001 처럼 서비스 이름을 씀)
FASTAPI_URL=http://localhost:8001

# IP Webcam [8단계] — 허용된 카메라 주소만, 쉼표로 구분
IP_WEBCAM_ALLOWED_URLS=http://192.168.0.10:8080/video
IP_WEBCAM_CAPTURE_SECONDS=8
